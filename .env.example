# Copernicus Marine credentials — sign up free at https://marine.copernicus.eu
COPERNICUSMARINE_USERNAME=your_username_here
COPERNICUSMARINE_PASSWORD=your_password_here

# Climate Data Store (ERA5 wave data for Stokes drift) — sign up free at
# https://cds.climate.copernicus.eu, then visit the API how-to page for your key:
# https://cds.climate.copernicus.eu/api-how-to
# You can either set the env vars below OR drop a ~/.cdsapirc file with:
#     url: https://cds.climate.copernicus.eu/api
#     key: YOUR_PERSONAL_KEY
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your_cds_api_key_here

# Tide model (pyTMD reads TPXO9-atlas-v5 NetCDF format).
# One-time setup:
#   1. Register free at https://www.tpxo.net/tpxo-products-and-registration
#   2. Download TPXO9-atlas-v5 NetCDF (~21 GB at 1/30° resolution: 1 grid +
#      15 elevation files + 15 transport files, all named *_tpxo9_atlas_30_v5.nc)
#   3. Unpack so the layout is <parent>/TPXO9_atlas_v5/<31 .nc files>
#   4. Point TIDE_MODEL_DIR to <parent> (NOT to TPXO9_atlas_v5/ — pyTMD's
#      database includes the subfolder name in its file paths).
# Alternative: FES2014 from AVISO+ — requires AVISO account.
TIDE_MODEL_DIR=/path/to/parent/of/TPXO9_atlas_v5
